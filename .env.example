# Postgres connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/bracketbuilder
# Neon:     postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bracketbuilder"

# Anthropic API key, used to research and seed bracket candidates.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Set to "false" to skip live web search during research and rely on the
# model's own knowledge (cheaper and faster, less current).
RESEARCH_WEB_SEARCH="true"

# Public origin, used to build shareable invite links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
